# ============================================
# Supabase
# ============================================
# Project API URL (e.g. https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable / anon key (safe for the browser; format: sb_publishable_... or legacy anon JWT)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# App
# ============================================
# Public base URL of the app (used for auth redirects / email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================
# Encryption (Phase 2 — Google OAuth token storage, aes-256-gcm)
# 32-byte key, hex-encoded (64 hex chars). Generate: openssl rand -hex 32
# ============================================
ENCRYPTION_KEY=

# ============================================
# Email transactional (Phase 2 — Resend)
# ============================================
RESEND_API_KEY=

# ============================================
# Google OAuth (Phase 2)
# ============================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
